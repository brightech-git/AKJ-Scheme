{
  "expo": {
    "name": "AkJ Mini Gold",
    "slug": "akj-scheme",
    "version": "1.0.16",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon2.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon2.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.akjgold.akj",
      "permissions": ["READ_MEDIA_IMAGES"],
      "targetSdkVersion": 35
    },
    "web": {
      "favicon": "./assets/icon2.png"
    },
    "extra": {
      "eas": {
        "projectId": "ded07a98-699d-4c9d-b063-32cfe4b82167"
      }
    },
    "owner": "brightechsoftware"
  }
}
